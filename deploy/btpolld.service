# systemd unit for btpolld on a plain Linux host with BlueZ (Raspberry Pi OS,
# Debian). Copy deploy/btpolld.toml.example to /etc/btpolld.toml, fill it in,
# and make it readable by btpolld alone (it may hold a push password):
#
#   useradd --system btpolld
#   install -m 0755 btpolld /usr/local/bin/
#   install -m 0640 -g btpolld btpolld.toml.example /etc/btpolld.toml
#
[Unit]
Description=Bluetooth LE sensors to remote write
Wants=bluetooth.service
After=bluetooth.service network-online.target
Wants=network-online.target

[Service]
User=btpolld
ExecStart=/usr/local/bin/btpolld --config /etc/btpolld.toml
Restart=on-failure
RestartSec=30s
# Exit status 3: bluetoothd is stuck, and only restarting it clears that.
# Either the scan is dead (no device heard for 3 minutes: the controller
# stopped scanning while bluetoothd believes it is scanning), or bluetoothd
# left two reads in a row unanswered. bluetoothd is restarted at most once per
# 30 minutes, so a device that is really gone cannot keep restarting it; "+"
# runs this as root.
ExecStopPost=+/bin/sh -c 'test "$$EXIT_STATUS" = 3 || exit 0; \
  up=$$(systemctl show -P ActiveEnterTimestampMonotonic bluetooth.service); \
  age=$$(( $$(cut -d. -f1 /proc/uptime) - up / 1000000 )); \
  if [ "$$age" -ge 1800 ]; then echo "restarting bluetoothd"; systemctl --no-block restart bluetooth.service; \
  else echo "bluetoothd restarted $${age}s ago; not again yet"; fi'
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
